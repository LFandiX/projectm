<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:id="@+id/main"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
tools:context=".MainActivity">

<EditText
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/message_edit"
    android:hint="Type something here..."/>
<Button
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="save"
    android:id="@+id/save_btn"/>

<Button
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Using Shared"
    android:id="@+id/save_btn_shared"
    />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Store from Shared Preference"
        android:id="@+id/StoreSP"/>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create book store"
        android:id="@+id/bookPstore"/>
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="add Db"
        android:id="@+id/adddb"
        />


<!--    PERTEMUAN BARU-->
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Make A Call"
        android:id="@+id/makecall"
        />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Read Contact"
        android:id="@+id/readcontact"
        />

</LinearLayout>




